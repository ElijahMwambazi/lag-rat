APP_PORT=8080
DATABASE_URL=sqlite://lag-rat.db
ROUTER_IP=192.168.1.1
ROUTER_PORT=80
CONNECTIVITY_INTERVAL_SECONDS=30
DNS_INTERVAL_SECONDS=60
DEVICE_INTERVAL_SECONDS=120
DNS_TEST_DOMAIN=google.com
DNS_TEST_DOMAINS=cloudflare.com,google.com,example.com
DNS_RESOLVER=1.1.1.1
PUBLIC_PROBE_URL=https://google.com
PUBLIC_PROBE_URLS=https://www.cloudflare.com,https://www.google.com/generate_204,https://example.com
REQUEST_TIMEOUT_MS=3000
ARP_TABLE_PATH=/proc/net/arp
INTERNET_TCP_HOST=1.1.1.1
INTERNET_TCP_PORT=443
INTERNET_TCP_TARGETS=1.1.1.1:443,8.8.8.8:443,9.9.9.9:443
LOCAL_SUBNET_CIDR=192.168.1.0/24
ACTIVE_DISCOVERY_ENABLED=true
ACTIVE_DISCOVERY_TIMEOUT_MS=400
WIFI_INTERVAL_SECONDS=60
WIFI_SAMPLING_ENABLED=true
WIFI_INTERFACE=wlo1
WIFI_LOCATION_LABEL=office
CAPTURE_WORKER_INTERVAL_SECONDS=10
CAPTURE_EXECUTION_ENABLED=true
CAPTURE_RETENTION_HOURS=24
CAPTURE_MAX_FILE_MB=50
CAPTURE_DEFAULT_DURATION_SECONDS=30
CAPTURE_MIN_DURATION_SECONDS=5
CAPTURE_MAX_DURATION_SECONDS=120
CAPTURE_OUTPUT_DIR=data/captures
CAPTURE_ALLOWED_INTERFACES=eth0,wlan0,wlp2s0,wlo1,docker0,
CAPTURE_READINESS_TEST_HOST=
